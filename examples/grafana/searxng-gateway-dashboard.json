      {
        "title": "Engine last-seen (per query)",
        "type": "timeseries",
        "description": "0 = SearXNG ha riportato l'engine come unresponsive nell'ultima risposta. 1 = l'engine ha prodotto risultati. Questo NON \u00e8 un health indicator \u2014 \u00e8 uno snapshot per-query. Per lo stato attuale dei blocchi (4xx) vedi il pannello CB Activity Timeline pi\u00f9 sotto.",
        "datasource": null,
        "targets": [
          {
            "refId": "A",
            "expr": "searxng_gateway_engine_status",
            "legendFormat": "{{engine}}",
            "datasource": {
              "name": "${datasource}"
            },
            "instant": false,
            "range": true,
            "hide": false
          }
        ],
        "transformations": [],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 30,
              "lineWidth": 2,
              "showPoints": "never",
              "stacking": {
                "mode": "none"
              }
            },
            "unit": "none"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "brave"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#F2495C",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 40
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "mojeek"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#FF780A",
                    "mode": "fixed"
                  }
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 40
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "mwmbl"
              },
              "properties": [
                {
                  "id": "color",
