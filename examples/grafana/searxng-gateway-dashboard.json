{
  "dashboard": {
    "title": "SearXNG \u2014 Engine Breakdown",
    "tags": [
      "searxng",
      "curated"
    ],
    "timezone": "browser",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "liveNow": false,
    "schemaVersion": 39,
    "editable": true,
    "links": [],
    "description": "SearXNG Gateway observability dashboard. Requires a Prometheus-compatible datasource scraping the gateway /metrics endpoint. Circuit breaker panels show per-engine state (closed/half-open/open), trips, and recoveries.",
    "annotations": {
      "list": [
        {
          "builtIn": true,
          "datasource": {
            "name": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "target": {
            "limit": 100,
            "matchAny": false,
            "tags": [],
            "type": "dashboard"
          },
          "type": "dashboard"
        },
        {
          "builtIn": 1,
          "datasource": {
            "name": "${datasource}"
          },
          "enable": true,
          "hide": false,
          "iconColor": "red",
          "name": "CB Trips",
          "target": {
            "limit": 100,
            "matchAny": false,
            "tags": [],
            "type": "dashboard"
          },
          "type": "dashboard"
        },
        {
          "builtIn": 1,
          "datasource": {
            "name": "${datasource}"
          },
          "enable": true,
          "hide": false,
          "iconColor": "green",
          "name": "CB Recoveries",
          "target": {
            "limit": 100,
            "matchAny": false,
            "tags": [],
            "type": "dashboard"
          },
          "type": "dashboard"
        }
      ]
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "title": "Requests per outcome (rate/min, 5m avg)",
        "type": "timeseries",
        "description": "Rate al minuto (5m avg) delle richieste per outcome. Stacked bars per vedere la proporzione.",
        "datasource": null,
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (outcome) (rate(searxng_gateway_requests_total[$__rate_interval])) * 60",
            "legendFormat": "{{outcome}}",
            "datasource": {
              "name": "${datasource}"
            },
            "instant": false,
            "range": true,
            "hide": false
          }
        ],
        "transformations": [],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 40,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "group": "A",
                "mode": "normal"
              }
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": [
              "last",
              "max",
              "mean"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        }
      },
      {
        "title": "Results per engine (rate/min, 5m avg)",
        "type": "timeseries",
        "description": "Rate al minuto (5m avg) dei risultati per engine. Stacked bars.",
        "datasource": null,
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (engine) (rate(searxng_gateway_engine_results_total[$__rate_interval])) * 60",
            "legendFormat": "{{engine}}",
            "datasource": {
              "name": "${datasource}"
            },
            "instant": false,
            "range": true,
            "hide": false
